# Gemini API Key (Required for AI Copilot & Adaptive Problem Generator)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project used for authenticated, persistent app data
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Run supabase/migrations/20261005000000_backend.sql in your Supabase project.
# Configure Google as an Auth provider in Supabase to enable Google sign-in.
# Add /auth/callback to the Supabase Auth redirect allow-list.
